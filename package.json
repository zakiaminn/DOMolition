{
  "name": "domolition",
  "version": "1.3.0",
  "description": "Blow up any DOM element: glass, collapse, slice, melt, disintegrate and more. React component or one plain-JS function.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.mts",
        "default": "./dist/vanilla.mjs"
      },
      "require": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/domolition.global.js",
  "jsdelivr": "./dist/domolition.global.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "react",
    "physics",
    "matterjs",
    "ui",
    "animation",
    "rage-quit",
    "shatter",
    "explode",
    "disintegrate",
    "thanos",
    "delete-animation",
    "easter-egg",
    "vanilla-js",
    "html-to-image"
  ],
  "author": "Zaki Amin Ahmad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakiaminn/DOMolition.git"
  },
  "bugs": {
    "url": "https://github.com/zakiaminn/DOMolition/issues"
  },
  "homepage": "https://zakiaminn.github.io/DOMolition/",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "html-to-image": "^1.11.13",
    "matter-js": "^0.20.0"
  }
}
