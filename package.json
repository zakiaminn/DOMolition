{
  "name": "domolition",
  "version": "1.0.1",
  "description": "The Rage Quit UI Shatter Engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "react",
    "physics",
    "matterjs",
    "ui",
    "animation",
    "rage-quit",
    "shatter",
    "html-to-image"
  ],
  "author": "Zaki Amin Ahmad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakiaminn/domolition.git"
  },
  "bugs": {
    "url": "https://github.com/zakiaminn/domolition/issues"
  },
  "homepage": "https://github.com/zakiaminn/domolition#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "html-to-image": "^1.11.13",
    "matter-js": "^0.20.0"
  }
}